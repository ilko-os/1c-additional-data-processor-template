// Обработка создана на базе проекта `Шаблон дополнительной обработки для конфигураций 1с на основе БСП`
// Документация и новые версии шаблона доступны по ссылке
// https://github.com/ilko-os/1c-additional-data-processor-template

// Основная форма обработки. Сама не отображается, а открывает форму обработки в зависимости от способа запуска.
// Для команд с типом "ВызовКлиентскогоМетода" БСП получает эту форму без открытия и вызывает ВыполнитьКоманду().

#Область ПрограммныйИнтерфейс

// Выполняет команду с типом "ВызовКлиентскогоМетода",
// см. ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовКлиентскогоМетода.
// Вызывается из БСП, а также кнопкой "Выполнить команду" формы настроек.
// Параметры, переданные БСП (в т.ч. ДополнительнаяОбработкаСсылка), доступны в реквизите ПараметрыОткрываемойФормы.
// Настройки обработки и команды при необходимости можно прочитать и сохранить в реквизитакх формы в процедуре `ПриСозданииНаСервере`
//
// Параметры:
//  ИдентификаторКоманды - Строка - Идентификатор команды определенный в функции "СведенияОВнешнейОбработке()"
&НаКлиенте
Процедура ВыполнитьКоманду(ИдентификаторКоманды) Экспорт

	// Начало области для модификации {{
	Если ИдентификаторКоманды = "Команда6" Тогда

		Команда6();

	ИначеЕсли ИдентификаторКоманды = "Команда7" Тогда

	
	Иначе

		ОбщегоНазначенияКлиент.СообщитьПользователю(
			СтрШаблон("Для команды ""%1"" не задан обработчик.", ИдентификаторКоманды));

	КонецЕсли;
	// }} Окончание области для модификации

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Если Параметры.Свойство("ИдентификаторКоманды") Тогда    
		
		ИмяОткрываемойФормы = "ФормаНастроек";
		
		// Параметры, с которыми БСП открыла основную форму, передаются в открываемую форму без изменений,
		// см. ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы.
		ПараметрыОткрываемойФормы = Новый Структура;
		ИменаПараметров = СтрРазделить("ИдентификаторКоманды,ДополнительнаяОбработкаСсылка,ИмяФормы,КлючСессии,ОбъектыНазначения", ",");
		Для Каждого ИмяПараметра Из ИменаПараметров Цикл
			ЗначениеПараметра = Неопределено;
			Если Параметры.Свойство(ИмяПараметра, ЗначениеПараметра) Тогда
				ПараметрыОткрываемойФормы.Вставить(ИмяПараметра, ЗначениеПараметра);
			КонецЕсли;
		КонецЦикла;
		
		КонтекстНастроек = ОбработкаОбъект.ПолучитьКонтекстНастроек(ПараметрыОткрываемойФормы.ИдентификаторКоманды, 
			ПараметрыОткрываемойФормы.ДополнительнаяОбработкаСсылка);
		
		НастройкиОбработки 						= КонтекстНастроек.НастройкиОбработки; 
		НастройкиОбработкиБезопасноеХранилище 	= КонтекстНастроек.НастройкиОбработкиБезопасноеХранилище; 
		НастройкиКоманды 						= КонтекстНастроек.НастройкиКоманды; 
		НастройкиКомандыБезопасноеХранилище 	= КонтекстНастроек.НастройкиКомандыБезопасноеХранилище;  
		КонтекстНастроекКоманды 				= КонтекстНастроек.КонтекстНастроекКоманды;
		КонтекстНастроекОбработки 				= КонтекстНастроек.КонтекстНастроекОбработки;
		
		
		ИдентификаторКоманды = ПараметрыОткрываемойФормы.ИдентификаторКоманды;
		
		
		// Начало области для модификации {{ 
		
		// Для команад с типом `ОткрытиеФормы` нужно в переменной `ИмяОткрываемойФормы` опеределить имя формы
		Если ИдентификаторКоманды = "Команда4" Тогда
			ИмяОткрываемойФормы = "Форма4";
		ИначеЕсли ИдентификаторКоманды = "Команда5" Тогда
			
		КонецЕсли;	
		
		// Для команад с типом `ВызовКлиентскогоМетода` при необходимости можно получить доступ к настрокам через 
		// переменную `КонтекстНастроек` и сохранить значения в реквизитах формы их для дальнейшего использования
		Если ИдентификаторКоманды = "Команда6" Тогда
			
		ИначеЕсли ИдентификаторКоманды = "Команда7" Тогда
			 
		КонецЕсли; 
		
		// }} Окончание области для модификации
		
		
	Иначе
		// Обработка открыта через "Файл - Открыть"
		ИмяОткрываемойФормы = "ФормаНастроек";
		ПараметрыОткрываемойФормы = Новый Структура;
	КонецЕсли;
	
	ИмяОбработки = ОбработкаОбъект.Метаданные().Имя;
	ПолноеИмяОткрываемойФормы = СтрШаблон("ВнешняяОбработка.%1.Форма.%2", ИмяОбработки, ИмяОткрываемойФормы);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Отказ = Истина;
	ОткрытьФорму(ПолноеИмяОткрываемойФормы, ПараметрыОткрываемойФормы, ВладелецФормы);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции


#Область ОбработчикиКоманд

&НаКлиенте
Процедура Команда6()

	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
