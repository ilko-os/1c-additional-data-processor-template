						стр.Контейнер));
					КонецЦикла;
				КонецЕсли;

				НастройкиКомандИОбработки[Команда.Идентификатор].Вставить("НастройкиКомандыБезопасноеХранилище",
					КомандаНастройкиКомандыБезопасноеХранилище);
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;

	НастройкиКоманды = НастройкиКомандИОбработки[ИдентификаторКоманды].НастройкиКоманды;
