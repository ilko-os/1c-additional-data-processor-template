	ПараметрыКоманды.Вставить("НастройкиОбработки", НастройкиОбработки);
	ПараметрыКоманды.Вставить("НастройкиОбработкиБезопасноеХранилище", НастройкиОбработкиБезопасноеХранилище);
	ПараметрыКоманды.Вставить("НастройкиКоманды", НастройкиКоманды);
	ПараметрыКоманды.Вставить("НастройкиКомандыБезопасноеХранилище", НастройкиКомандыБезопасноеХранилище);

	НастройкиКомандИОбработки.Вставить("НастройкиОбработки", НастройкиОбработки);
	НастройкиКомандИОбработки.Вставить("НастройкиОбработкиБезопасноеХранилище", НастройкиОбработкиБезопасноеХранилище);				

