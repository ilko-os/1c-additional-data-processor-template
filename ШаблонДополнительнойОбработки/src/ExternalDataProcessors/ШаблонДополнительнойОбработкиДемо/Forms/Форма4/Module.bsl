// Обработка создана на базе проекта `Шаблон дополнительной обработки для конфигураций 1с на основе БСП`
// Документация и новые версии шаблона доступны по ссылке
// https://github.com/ilko-os/1c-additional-data-processor-template

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");     
	
	// Параметры, с которыми БСП открыла основную форму, передаются в открываемую форму без изменений,
	// см. ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы.
	ПараметрыОткрываемойФормы = Новый Структура;
	ИменаПараметров = СтрРазделить("ИдентификаторКоманды,ДополнительнаяОбработкаСсылка,ИмяФормы,КлючСессии,ОбъектыНазначения", ",");
	Для Каждого ИмяПараметра Из ИменаПараметров Цикл
		ЗначениеПараметра = Неопределено;
		Если Параметры.Свойство(ИмяПараметра, ЗначениеПараметра) Тогда
			ПараметрыОткрываемойФормы.Вставить(ИмяПараметра, ЗначениеПараметра);
		КонецЕсли;
	КонецЦикла;
	
	КонтекстНастроек = ОбработкаОбъект.ПолучитьКонтекстНастроек(ПараметрыОткрываемойФормы.ИдентификаторКоманды, 
		ПараметрыОткрываемойФормы.ДополнительнаяОбработкаСсылка);
	
	НастройкиОбработки 						= КонтекстНастроек.НастройкиОбработки; 
	НастройкиОбработкиБезопасноеХранилище 	= КонтекстНастроек.НастройкиОбработкиБезопасноеХранилище; 
	НастройкиКоманды 						= КонтекстНастроек.НастройкиКоманды; 
	НастройкиКомандыБезопасноеХранилище 	= КонтекстНастроек.НастройкиКомандыБезопасноеХранилище;  
	КонтекстНастроекКоманды 				= КонтекстНастроек.КонтекстНастроекКоманды;
	КонтекстНастроекОбработки 				= КонтекстНастроек.КонтекстНастроекОбработки;

	
	

	Заголовок = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(НастройкиКоманды, "ЗаголовокФормы", Заголовок);

КонецПроцедуры

#КонецОбласти
